{
  "name": "ctsgo-rules-tests",
  "private": true,
  "description": "Firestore security-rules tests for CTSGo, run against the local emulator only.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-ctsgo-rules --config ../firebase.json \"mocha\"",
    "test:driver-rules": "RULES_FILE=../../../driver/cts-transport-driver-app-clean/firestore.rules npm test",
    "check-deployed": "bash scripts/check-deployed-rules.sh"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "mocha": "11.7.1"
  }
}
