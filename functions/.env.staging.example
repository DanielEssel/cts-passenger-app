# Staging payment config template. Copy to .env.staging once a "staging" alias
# exists in .firebaserc (Firebase loads .env.<alias>), or to .env.<staging-id>.
# Do NOT put production values here; config.js refuses them outside production.
PAYMENTS_MODE=sandbox
# Unknown until Bridge confirms a sandbox/test host. Left empty, every Bridge
# request fails closed. The live host api.bridgeagw.com is refused in sandbox
# mode, and callbacks must use this project's own cloudfunctions.net host.
BRIDGE_API_BASE=
BRIDGE_CALLBACK_BASE_URL=https://europe-west2-<staging-project-id>.cloudfunctions.net
